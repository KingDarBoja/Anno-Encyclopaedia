{
  "name": "anno117_stats",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "includedScripts": [],
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/anno117_stats/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/anno117_stats",
        "browser": "apps/anno117_stats/src/main.ts",
        "tsConfig": "apps/anno117_stats/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "styles": [
          "apps/anno117_stats/src/styles.scss",
          "apps/anno117_stats/src/tailwind.css"
        ],
        "assets": [
          "apps/anno117_stats/src/site.webmanifest",
          {
            "glob": "**/*",
            "input": "libs/shared/assets/src/favicon",
            "output": "favicon"
          },
          {
            "glob": "**/*",
            "input": "libs/shared/assets/src/assets",
            "output": "assets"
          },
          {
            "glob": "**/*",
            "input": "libs/shared/assets/src/data",
            "output": "assets/data"
          }
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "5kb",
              "maximumError": "20kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "anno117_stats:build:production"
        },
        "development": {
          "buildTarget": "anno117_stats:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/anno117_stats/src"]
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {}
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "anno117_stats:build",
        "port": 4200,
        "staticFilePath": "dist/anno117_stats/browser",
        "spa": true
      }
    },
    "deploy": {
      "executor": "angular-cli-ghpages:deploy",
      "options": {
        "dir": "dist/anno117_stats/browser",
        "repo": "git@github.com:KingDarBoja/anno117_stats.git",
        "baseHref": "/anno117_stats/",
        "nojekyll": true
      }
    }
  }
}
